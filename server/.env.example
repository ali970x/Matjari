PORT=4000
NODE_ENV=development
JWT_SECRET=replace-this-local-secret
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
PUBLIC_BASE_URL=

# Keep the default JSON backend for local demos. Use "supabase" after creating
# the matjari_state table from README.md and setting the Supabase variables.
DATA_BACKEND=json
UPLOAD_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STATE_TABLE=matjari_state
SUPABASE_STATE_ID=default
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_PREFIX=uploads
